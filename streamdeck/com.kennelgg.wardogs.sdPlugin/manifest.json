{
  "Name": "Kennel.gg Wardogs",
  "Version": "0.2.0.0",
  "Author": "The Kennel [KNL]",
  "Description": "Keys and dials for the Kennel.gg Wardogs Streaming Tool in OBS: squad mate POVs, clips, instant replay, the session stats bar and its live numbers, role bars, Dual POV, stingers, voice control and more.",
  "Icon": "imgs/plugin/marketplace",
  "UUID": "com.kennelgg.wardogs",
  "Category": "Kennel.gg Wardogs",
  "CategoryIcon": "imgs/plugin/category",
  "CodePath": "bin/plugin.js",
  "URL": "https://kennel.gg/streaming",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.4"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    }
  ],
  "Nodejs": {
    "Version": "20",
    "Debug": "disabled"
  },
  "Actions": [
    {
      "Name": "Squad mate POV",
      "UUID": "com.kennelgg.wardogs.pov",
      "Icon": "imgs/actions/pov/icon",
      "Tooltip": "Show a squad mate's POV on stream, or the one who is live in Kennel.gg voice; press again to come back to your own",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/pov/key",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "imgs/actions/pov/key-on",
          "TitleAlignment": "bottom"
        }
      ],
      "PropertyInspectorPath": "ui/pov.html"
    },
    {
      "Name": "Next squad mate",
